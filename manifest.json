{
  "manifest_version": 3,
  "name": "IIT KGP ERP - Stay Logged In",
  "version": "1.0.0",
  "description": "Keeps your IIT Kharagpur ERP portal session active and automatically handles session timeout popups.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "IIT KGP ERP - Stay Logged In"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://erp.iitkgp.ac.in/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "erp-stay-logged-in@iitkgp.ac.in",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://erp.iitkgp.ac.in/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
